# Streamlit Community Cloud 배포용 시크릿 템플릿
# 사용법: 이 파일을 복사해 .streamlit/secrets.toml 을 만들거나,
#         Streamlit Cloud 앱 설정 > Secrets 에 아래 내용을 그대로 붙여넣으세요.

GEMINI_API_KEY = "your_gemini_api_key_here"

TELEGRAM_BOT_TOKEN = "123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID = "123456789"

# 콘솔 접근 비밀번호. 공개 URL에 배포한다면 반드시 설정하세요.
# 설정하지 않으면 주소를 아는 누구나 조건을 추가·삭제할 수 있습니다.
APP_PASSWORD = "여기에_원하는_비밀번호"

# 미설정 시 app/config.py 의 기본값을 사용합니다 (gemini-3.6-flash)
GEMINI_MODEL = "gemini-3.6-flash"
DEFAULT_CURRENCY = "KRW"

# 대시보드 -> GitHub DB 동기화용 (Contents 읽기/쓰기 권한 토큰)
GITHUB_TOKEN = "github_pat_your_token"
GITHUB_REPO = "UNJUNGSAM/Airplane-FARE-WATCH"
GITHUB_BRANCH = "main"
