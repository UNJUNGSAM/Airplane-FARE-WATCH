# ===== 필수 키 =====

# Gemini API 키 - https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=your_gemini_api_key_here

# 텔레그램 봇 토큰 - @BotFather에게 /newbot 으로 생성 후 발급
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# 알림 받을 chat ID - 봇에게 메시지 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 확인
TELEGRAM_CHAT_ID=123456789

# ===== 선택 =====

# Gemini 모델명 (기본값: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 기본 통화 (KRW, USD, JPY, EUR ...)
DEFAULT_CURRENCY=KRW

# ===== Streamlit 클라우드 배포 시 필요 =====
# 대시보드에서 감시 조건을 바꾸면 GitHub 저장소의 DB를 갱신하는 데 사용됩니다.
# 권한: repo (Contents read/write) 만 있으면 됩니다.
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=username/airplane-tracer
GITHUB_BRANCH=main
